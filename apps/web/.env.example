# fixture is safe for previews and contains no provider credentials.
VITE_TABI_DATA_MODE=fixture
# In remote mode this must be same-origin in production (normally /v1).
VITE_TABI_API_BASE_URL=/v1
# Used only by the Vite development server; it is not exposed to browser code.
# TABI_WEB_API_PROXY=http://127.0.0.1:8080
# A restricted public browser Maps SDK token. VITE_* values are public, so do
# not put server, download, Search, or Geocoding credentials here.
VITE_MAPBOX_ACCESS_TOKEN=
# Must be a Mapbox style URL or https URL approved for the browser map.
VITE_MAPBOX_STYLE_URL=mapbox://styles/mapbox/light-v11
