# A restricted, public mobile Maps SDK token. Leave empty to run the synthetic
# capability-disabled shell. Never place server, download, or provider tokens here.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# `fixture` is deterministic and needs no network. Set `remote` only for a
# local/development Tabi API origin; this is not a provider URL.
EXPO_PUBLIC_API_MODE=fixture
EXPO_PUBLIC_API_BASE_URL=
