{
  "name": "@tabi/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "android:prereqs": "node ./scripts/android-emulator.mjs prereqs",
    "android:simulators": "node ./scripts/android-emulator.mjs ensure-all",
    "android:motorola-razr-2024": "node ./scripts/android-emulator.mjs run motorola-razr-2024-android-16",
    "android:pixel-10-pro": "node ./scripts/android-emulator.mjs run pixel-10-pro-android-17",
    "android:sony-xperia-1-ii": "node ./scripts/android-emulator.mjs run sony-xperia-1-ii-android-12",
    "ios": "expo run:ios",
    "ios:prereqs": "node ./scripts/ios-simulator.mjs prereqs",
    "ios:simulators": "node ./scripts/ios-simulator.mjs ensure-all",
    "ios:iphone-13-mini": "node ./scripts/ios-simulator.mjs run iphone-13-mini-ios-18",
    "ios:iphone-air": "node ./scripts/ios-simulator.mjs run iphone-air-ios-26",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@rnmapbox/maps": "10.3.5",
    "@tanstack/react-query": "5.66.8",
    "expo": "53.0.20",
    "expo-constants": "17.1.8",
    "expo-dev-client": "5.2.4",
    "expo-router": "5.1.4",
    "expo-sqlite": "15.2.14",
    "expo-status-bar": "2.2.3",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "4.11.1",
    "zod": "3.24.2",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@testing-library/react-native": "13.2.0",
    "@types/react": "19.0.10",
    "react-test-renderer": "19.0.0",
    "vite": "6.2.2",
    "vitest": "3.2.4"
  }
}
