{
  "name": "@tabi/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "node ./scripts/android-emulator.mjs run motorola-razr-2024-android-16",
    "android:prereqs": "node ./scripts/android-emulator.mjs prereqs",
    "android:simulators": "node ./scripts/android-emulator.mjs ensure-all",
    "android:motorola-razr-2024": "node ./scripts/android-emulator.mjs run motorola-razr-2024-android-16",
    "android:pixel-10-pro": "node ./scripts/android-emulator.mjs run pixel-10-pro-android-16",
    "android:sony-xperia-1-ii": "node ./scripts/android-emulator.mjs run sony-xperia-1-ii-android-12",
    "ios": "expo run:ios",
    "ios:prereqs": "node ./scripts/ios-simulator.mjs prereqs",
    "ios:simulators": "node ./scripts/ios-simulator.mjs ensure-all",
    "ios:iphone-13-mini": "node ./scripts/ios-simulator.mjs run iphone-13-mini-ios-26",
    "ios:iphone-air": "node ./scripts/ios-simulator.mjs run iphone-air-ios-26",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@rnmapbox/maps": "10.3.5",
    "@tanstack/react-query": "5.101.4",
    "expo": "57.0.12",
    "expo-constants": "57.0.10",
    "expo-dev-client": "57.0.11",
    "expo-linking": "~57.0.5",
    "expo-router": "57.0.12",
    "expo-sqlite": "57.0.1",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.2",
    "@testing-library/react-native": "14.0.1",
    "@types/geojson": "7946.0.16",
    "@types/react": "19.2.18",
    "react-dom": "19.2.3",
    "react-test-renderer": "19.2.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
