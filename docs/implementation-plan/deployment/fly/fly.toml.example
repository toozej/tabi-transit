app = "tabi-example"
primary_region = "REPLACE_WITH_ME"

[build]
image = "ghcr.io/example/tabi-backend@sha256:REPLACE_ME"

[processes]
web = "/app/transit-api"
poller = "/app/realtime-poller"
worker = "/app/notification-worker"

[http_service]
internal_port = 8080
force_https = true
processes = ["web"]
auto_start_machines = true
auto_stop_machines = "stop"
min_machines_running = 0

[[http_service.checks]]
grace_period = "20s"
interval = "15s"
method = "GET"
path = "/health/ready"
timeout = "5s"

[env]
APP_ENV = "production"
HTTP_LISTEN_ADDR = ":8080"
LOG_FORMAT = "json"
