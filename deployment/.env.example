# Non-secret host configuration. Copy to /opt/tabi/.env with root-owned permissions.
COMPOSE_PROJECT_NAME=tabi
TABI_API_DOMAIN=api.example.com
POSTGRES_DB=tabi
POSTGRES_USER=tabi
TABI_SECRETS_DIR=/etc/tabi/secrets
TABI_FEED_ARCHIVE_DIR=/var/lib/tabi/feed-archive
TABI_STATIC_ARTIFACT_DIR=/var/lib/tabi/static-artifacts
APP_ENV=production
HTTP_LISTEN_ADDR=:8080
LOG_FORMAT=json
LOG_LEVEL=info
# Approved production GTFS-Realtime URLs and the exact comma-separated hosts
# they may contact. The poller refuses redirects outside this allowlist.
GTFSRT_SOURCE_ID=trimet
GTFSRT_VEHICLE_ENDPOINT=https://example.invalid/gtfsrt/vehicle-positions
GTFSRT_TRIP_UPDATES_ENDPOINT=https://example.invalid/gtfsrt/trip-updates
GTFSRT_ALLOWED_HOSTS=example.invalid
