{
  "name": "tabi",
  "version": "0.0.0",
  "private": true,
  "description": "Tabi transit monorepo",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20.19.0 <23",
    "pnpm": ">=10.13.1 <11"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "build": "corepack pnpm --recursive --if-present run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@redocly/cli": "2.43.2",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "openapi-typescript": "7.13.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
